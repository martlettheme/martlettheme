---
interface Props { items: { href: string; label: string }[]; }
const { items } = Astro.props as Props;
---
<nav class="section-nav" aria-label="On this page">
  <div class="container"><ul>{items.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul></div>
</nav>
<style>
  .section-nav { padding-block: 1rem; background: var(--color-cream); }
  ul { display: flex; flex-wrap: wrap; gap: .4rem 1.75rem; margin: 0; padding: 0; list-style: none; font: 700 .88rem/1.5 var(--font-sans); }
  a { display: inline-block; padding-block: .35rem; color: var(--color-navy-900); text-decoration-color: var(--color-gold-500); }
  a:hover { color: var(--color-gold-700); }
</style>
