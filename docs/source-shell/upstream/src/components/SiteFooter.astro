---
import siteData from '../../.generated/data/site.json';
import { sitePath } from '../lib/site';

const otherSites = (siteData.settings.sites ?? []).filter((item:any) => item.footer);
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div><h2>Other Sites</h2><ul>{otherSites.map((item:any)=><li><a href={item.url} target={item.target} rel={item.target ? 'noopener noreferrer' : undefined}>{item.title}</a></li>)}</ul></div>
    <div><h2>Notices</h2><ul>{siteData.settings.notices.map((item:any)=><li><a href={sitePath(item.url)} data-cookie-preferences={item.data?.['cookie-preferences'] != null ? '' : undefined}>{item.title}</a></li>)}</ul></div>
    <div><h2>Follow me on</h2><ul class="social-list">{siteData.settings.social_media.map((item:any)=><li><a href={item.url} rel="me noopener">{item.name}</a></li>)}</ul></div>
  </div>
  <div class="container footer-bottom"><a class="footer-identity" href="/" aria-label="James Howard home"><img src="/assets/img/identity/jh-badge-1x1.svg" alt=""><span><strong>jameshoward.us</strong><br>A website of James Howard</span></a><p>Copyright © 1997–{new Date().getUTCFullYear()} James P. Howard, II</p></div>
</footer>
<style>
  .site-footer{padding-block:4rem 1.5rem;color:#dce5ee;background:var(--color-navy-950);font-family:var(--font-sans)}.footer-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(2rem,6vw,5rem)}h2{margin:0 0 1rem;padding-bottom:.65rem;border-bottom:1px solid rgb(255 255 255/.13);color:#fff;font-size:.92rem;letter-spacing:.08em;text-transform:uppercase}ul{margin:0;padding:0;list-style:none}li{margin:.45rem 0}.social-list{display:grid;grid-auto-flow:column;grid-template-rows:repeat(5,auto);grid-template-columns:repeat(2,minmax(0,1fr));column-gap:2rem}.site-footer a{color:#dce5ee;text-decoration:none}.site-footer a:hover,.site-footer a:focus-visible{color:var(--color-gold-300);text-decoration:underline;text-decoration-thickness:.08em;text-underline-offset:.16em}.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:2rem;margin-top:3rem;padding-top:1.5rem;border-top:1px solid rgb(255 255 255/.15);font-size:.82rem}.footer-identity{display:flex;align-items:center;gap:1rem;text-decoration:none!important}.footer-identity img{width:3.5rem}.footer-identity strong{color:#fff;font-family:var(--font-display);font-size:1rem}@media(max-width:44rem){.footer-grid{grid-template-columns:1fr}.social-list{display:block}.footer-bottom{align-items:flex-start;flex-direction:column}}
</style>
