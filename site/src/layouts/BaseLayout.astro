---
import MartletLayout from '@martlet/astro/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';
import '../styles/site-chrome.css';
const { title = 'Martlet Theme — Light & Dark', description = 'Martlet Light and Dark, an open-source design system for websites, editors, terminals, and applications.' } = Astro.props;
---
<MartletLayout title={title} description={description} mainId="main" mainTabindex={-1}>
  <Fragment slot="head">
  <meta name="theme-color" content="#154c9e" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
</Fragment>
  <header slot="header" class="mast">
    <a class="brand" href="/"><img class="brand-mark" src="/martlet-mark.svg" width="38" height="38" alt="" /> <span>Martlet <small>Theme</small></span></a>
    <nav aria-label="Sections"><a href="/#preview">Explore</a><a href="/#palette">Colors</a><a href="/#downloads">Downloads</a><a href="/#story">Story</a><a href="/layouts/">Layouts</a><a href="/design-system/">Design system</a><a class="gitlink" href="https://github.com/martlettheme/martlettheme">GitHub ↗</a></nav>
  </header>
  <slot />
  <Fragment slot="footer"><SiteFooter /><CookieConsent /></Fragment>
</MartletLayout>
