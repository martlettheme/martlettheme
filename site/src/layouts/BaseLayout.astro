---
import MartletLayout from '@martlet/astro/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';
import '../styles/site-chrome.css';
const canonical = new URL(Astro.url.pathname, Astro.site);
const { title = 'Martlet · Design language 0.3 preview', description = 'Martlet Light and Dark, an independent design language for publishing, services, and applications, with components, patterns and agent tools.' } = Astro.props;
---
<MartletLayout title={title} description={description} mainId="main" mainTabindex={-1}>
  <Fragment slot="head">
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#154c9e" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
</Fragment>
  <SiteHeader slot="header" />
  <slot />
  <Fragment slot="footer"><SiteFooter /><CookieConsent /></Fragment>
</MartletLayout>
